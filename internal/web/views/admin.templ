package views

// AdminFrame is what every admin page needs for its shell.
type AdminFrame struct {
	Accent    string
	OwnerName string
	// Current is the nav key of the page: invites, bookings, availability,
	// sources, activity or settings.
	Current   string
	CanLogout bool
}

var adminNav = []struct{ Key, Label, Href string }{
	{"invites", "Invites", "/admin/invites"},
	{"bookings", "Bookings", "/admin/bookings"},
	{"availability", "Availability", "/admin/availability"},
	{"sources", "Calendar sources", "/admin/sources"},
	{"activity", "Activity", "/admin/activity"},
	{"settings", "Settings", "/admin/settings"},
}

func navCurrent(on bool) string {
	if on {
		return "page"
	}
	return "false"
}

templ adminLayout(title string, f AdminFrame) {
	<!DOCTYPE html>
	<html lang="en">
		@head(title, f.Accent)
		<body>
			<div class="shell">
				<nav class="nav" aria-label="Admin">
					<a class="nav-brand" href="/admin/invites">
						@logoMark(28, false)
						<span>hima</span>
					</a>
					<div class="navlist">
						for _, n := range adminNav {
							<a href={ templ.SafeURL(n.Href) } aria-current={ navCurrent(n.Key == f.Current) }>{ n.Label }</a>
						}
					</div>
					if f.CanLogout {
						<form method="post" action="/admin/logout" class="nav-foot">
							<button type="submit" class="link-btn">Log out</button>
						</form>
					}
				</nav>
				<main class="a-main">
					{ children... }
				</main>
			</div>
			@copyScript()
		</body>
	</html>
}

// ---------- Invites ----------

type SourceLine struct {
	OK   bool
	Text string
}

type InviteRow struct {
	ID        int64
	Label     string
	State     string
	PillClass string
	Uses      string
	Expires   string
	Durations string
	Location  string
	Active    bool
}

type InvitesPage struct {
	AdminFrame
	Sources     SourceLine
	ActiveOnly  bool
	ActiveCount int
	AllCount    int
	Rows        []InviteRow
}

templ Invites(p InvitesPage) {
	@adminLayout("Invites", p.AdminFrame) {
		<div class="a-head">
			<div class="stack gap-6">
				<h1 class="a-title">Invites</h1>
				<a href="/admin/sources" class="status-line small muted">
					<span aria-hidden="true" class={ "dot", templ.KV("dot-ok", p.Sources.OK), templ.KV("dot-warn", !p.Sources.OK) }></span>
					{ p.Sources.Text }
				</a>
			</div>
			<a class="btn" href="/admin/invites/new">
				@iconPlus(18)
				New Invite
			</a>
		</div>
		<div class="segmented" role="group" aria-label="Filter">
			<a href="/admin/invites?filter=active" aria-current={ boolAttr(p.ActiveOnly) }>Active · { itoa(p.ActiveCount) }</a>
			<a href="/admin/invites" aria-current={ boolAttr(!p.ActiveOnly) }>All · { itoa(p.AllCount) }</a>
		</div>
		if len(p.Rows) == 0 {
			<div class="card">
				<p class="muted">No Invites yet. Create one and send the link to a friend.</p>
			</div>
		} else {
			<div class="table-box">
				<table class="table">
					<thead>
						<tr>
							<th scope="col">Label</th>
							<th scope="col">State</th>
							<th scope="col">Uses</th>
							<th scope="col">Expires</th>
							<th scope="col">Durations</th>
							<th scope="col">Location</th>
							<th scope="col"><span class="sr-only">Actions</span></th>
						</tr>
					</thead>
					<tbody>
						for _, r := range p.Rows {
							<tr class={ templ.KV("dim", !r.Active) }>
								<td class="label-cell"><a href={ templ.SafeURL("/admin/invites/" + itoa64(r.ID)) }>{ r.Label }</a></td>
								<td><span class={ "pill", r.PillClass }>{ r.State }</span></td>
								<td class="mono">{ r.Uses }</td>
								<td>{ r.Expires }</td>
								<td class="mono">{ r.Durations }</td>
								<td>{ r.Location }</td>
								<td>
									<div class="actions">
										<a class="link-btn" href={ templ.SafeURL("/admin/invites/" + itoa64(r.ID)) }>Edit</a>
										if r.Active {
											<form method="post" action={ templ.SafeURL("/admin/invites/" + itoa64(r.ID) + "/revoke") } onsubmit="return confirm('Revoke this Invite? Bookings already made stay.')">
												<button type="submit" class="link-btn danger">Revoke</button>
											</form>
										}
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		<p class="small muted">Revoking stops new Bookings only. Bookings already made stay.</p>
	}
}

// ---------- New Invite ----------

type Option struct {
	Value    string
	Label    string
	Selected bool
}

type DurationOption struct {
	Minutes int
	Label   string
	Checked bool
}

type NewInviteForm struct {
	Label          string
	ExpiresOptions []Option
	MaxUses        int
	Durations      []DurationOption
	RangeStart     string
	RangeEnd       string
	LocationKinds  []Option
	Location       string
	ShowBusy       bool
}

type NewInvitePage struct {
	AdminFrame
	Form             NewInviteForm
	Error            string
	TZ               string
	AvailabilityHint string
	PreviewTitle     string
	PreviewSummary   string
	PreviewSlots     string
}

templ NewInvite(p NewInvitePage) {
	@adminLayout("New Invite", p.AdminFrame) {
		<div class="stack gap-8">
			<a class="crumb" href="/admin/invites">← Invites</a>
			<h1 class="a-title">New Invite</h1>
		</div>
		if p.Error != "" {
			<p class="error" role="alert">{ p.Error }</p>
		}
		<form method="post" action="/admin/invites" class="cols">
			<div class="col-2">
				<div role="group" aria-labelledby="gcan" class="card">
					<h2 id="gcan" class="eyebrow ruled">Can change after sharing</h2>
					<div class="field">
						<label for="lbl">Label</label>
						<input id="lbl" class="input" type="text" name="label" value={ p.Form.Label } placeholder="Alex"/>
						<span class="hint">Private to you. Pre-fills the Guest's name, which they can change.</span>
					</div>
					<div class="grid-fields">
						<div class="field">
							<label for="exp">Expires after</label>
							<select id="exp" class="input" name="expires_in_days">
								for _, o := range p.Form.ExpiresOptions {
									<option value={ o.Value } selected?={ o.Selected }>{ o.Label }</option>
								}
							</select>
							<span class="hint">Counted from now.</span>
						</div>
						<div class="field">
							<label for="uses">Bookings allowed</label>
							<input id="uses" class="input mono" type="number" name="max_uses" min="1" value={ itoa(p.Form.MaxUses) }/>
							<span class="hint">Reschedules don't count.</span>
						</div>
					</div>
				</div>
				<div role="group" aria-labelledby="gfix" class="card" style="gap: 20px">
					<h2 id="gfix" class="eyebrow ruled">Fixed once shared</h2>
					<div class="stack gap-8">
						<span id="durl" class="label">Durations</span>
						<div role="group" aria-labelledby="durl" class="chips">
							for _, d := range p.Form.Durations {
								<label class="chip mono">
									<input type="checkbox" name="durations" value={ itoa(d.Minutes) } checked?={ d.Checked }/>
									<span>{ d.Label }</span>
								</label>
							}
						</div>
					</div>
					<div class="stack gap-8">
						<span class="label">Dates <span class="muted" style="font-weight: 400">(optional, { p.TZ })</span></span>
						<div class="row gap-10">
							<label for="from" class="sr-only">From</label>
							<input id="from" class="input" style="width: 170px" type="date" name="range_start" value={ p.Form.RangeStart }/>
							<span aria-hidden="true" class="muted">to</span>
							<label for="to" class="sr-only">To (inclusive)</label>
							<input id="to" class="input" style="width: 170px" type="date" name="range_end" value={ p.Form.RangeEnd }/>
						</div>
						<span class="hint">{ p.AvailabilityHint }</span>
					</div>
					<div class="stack gap-8">
						<span id="locl" class="label">Location</span>
						<div role="radiogroup" aria-labelledby="locl" class="chips">
							for _, l := range p.Form.LocationKinds {
								<label class="chip">
									<input type="radio" name="location_kind" value={ l.Value } checked?={ l.Selected }/>
									<span>{ l.Label }</span>
								</label>
							}
						</div>
						<label for="locv" class="sr-only">Address, phone number or video link</label>
						<input id="locv" class="input" type="text" name="location" value={ p.Form.Location } placeholder="Address, phone number or video link"/>
						<span class="hint">Guests see the kind before booking and the details after.</span>
					</div>
					<label class="check">
						<input type="checkbox" name="show_busy" value="1" checked?={ p.Form.ShowBusy }/>
						<span class="stack gap-2">
							<span style="font-weight: 500">Show my busy times</span>
							<span class="hint">Guests see when you're taken (never what), only inside these dates.</span>
						</span>
					</label>
				</div>
				<div class="row gap-12">
					<button type="submit" class="btn" style="height: 48px; padding: 0 22px">Create Invite</button>
					<a class="btn btn-plain" style="height: 48px" href="/admin/invites">Cancel</a>
				</div>
			</div>
			<aside aria-label="Guest preview" class="col-1 card dashed">
				<span class="eyebrow">Guest will see</span>
				<span style="font-size: 18px; font-weight: 700">{ p.PreviewTitle }</span>
				<span class="ink-2" style="font-size: 14px">{ p.PreviewSummary }</span>
				<span class="mono ink-2" style="font-size: 14px">{ p.PreviewSlots }</span>
				<span class="small muted" style="line-height: 1.5">Not shown: the Label, your calendar details, uses left.</span>
			</aside>
		</form>
	}
}

// ---------- One Invite ----------

type KV struct {
	Key   string
	Value string
}

type InviteBooking struct {
	When   string
	Name   string
	Status string
}

type InvitePage struct {
	AdminFrame
	ID           int64
	Title        string
	State        string
	PillClass    string
	Link         string
	Editable     bool
	Label        string
	ExpiresInput string
	MaxUses      int
	MinUses      int
	Fixed        []KV
	UsedText     string
	Bookings     []InviteBooking
	EmptyText    string
	Revocable    bool
	Error        string
	Saved        bool
}

templ Invite(p InvitePage) {
	@adminLayout(p.Title, p.AdminFrame) {
		<div class="stack gap-8">
			<a class="crumb" href="/admin/invites">← Invites</a>
			<div class="row gap-12">
				<h1 class="a-title">{ p.Title }</h1>
				<span class={ "pill", p.PillClass }>{ p.State }</span>
			</div>
		</div>
		if p.Link != "" {
			<section aria-labelledby="once" class="card dark">
				<h2 id="once">Copy the link now. It's shown only once.</h2>
				@copyRow("inv", "Invite link", p.Link, "btn-light")
				<p class="pretty">hima keeps only a hash of it. If it's lost before you send it, revoke this Invite and make a new one.</p>
			</section>
		}
		if p.Error != "" {
			<p class="error" role="alert">{ p.Error }</p>
		}
		if p.Saved {
			<p class="notice" role="status">Saved.</p>
		}
		<div class="cols">
			<section aria-labelledby="set" class="col-2 card">
				<h2 id="set">Settings</h2>
				if p.Editable {
					<form method="post" action={ templ.SafeURL("/admin/invites/" + itoa64(p.ID)) } class="stack gap-18">
						<div class="grid-fields">
							<div class="field">
								<label for="lbl">Label</label>
								<input id="lbl" class="input" type="text" name="label" value={ p.Label }/>
							</div>
							<div class="field">
								<label for="exp">Expires</label>
								<input id="exp" class="input" type="datetime-local" name="expires_at" value={ p.ExpiresInput }/>
							</div>
							<div class="field">
								<label for="uses">Bookings allowed</label>
								<input id="uses" class="input mono" type="number" name="max_uses" min={ itoa(p.MinUses) } value={ itoa(p.MaxUses) }/>
							</div>
						</div>
						@fixedFacts(p.Fixed)
						<div><button type="submit" class="btn">Save</button></div>
					</form>
				} else {
					@fixedFacts(p.Fixed)
				}
			</section>
			<div class="col-1">
				<section aria-labelledby="bk" class="card" style="gap: 10px">
					<div class="row" style="justify-content: space-between; align-items: baseline">
						<h2 id="bk">Bookings</h2>
						<span class="mono small muted">{ p.UsedText }</span>
					</div>
					if len(p.Bookings) == 0 {
						<p class="muted" style="font-size: 14px">{ p.EmptyText }</p>
					} else {
						for _, b := range p.Bookings {
							<div class="stack gap-2" style="font-size: 14px">
								<span><strong>{ b.Name }</strong> · <span class="mono">{ b.When }</span></span>
								<span class="small muted">{ b.Status }</span>
							</div>
						}
					}
				</section>
				if p.Revocable {
					<section aria-labelledby="rv" class="card danger">
						<h2 id="rv" style="font-size: 16px">Revoke</h2>
						<p class="ink-2" style="font-size: 14px; line-height: 1.5">Stops new Bookings right away. Existing Bookings stay.</p>
						<form method="post" action={ templ.SafeURL("/admin/invites/" + itoa64(p.ID) + "/revoke") } onsubmit="return confirm('Revoke this Invite?')">
							<button type="submit" class="btn btn-danger">Revoke Invite</button>
						</form>
					</section>
				}
			</div>
		</div>
	}
}

templ fixedFacts(facts []KV) {
	<div class="hr"></div>
	<div class="stack gap-10">
		<span class="row gap-6 eyebrow muted">
			@iconLock(14)
			Fixed, already shared
		</span>
		<dl class="kv">
			for _, f := range facts {
				<dt>{ f.Key }</dt>
				<dd>{ f.Value }</dd>
			}
		</dl>
	</div>
}

// ---------- Bookings ----------

type BookingRow struct {
	ID           int64
	Day          string
	Time         string
	Name         string
	Tag          string
	TagClass     string
	Invite       string
	Location     string
	Note         string
	Past         bool
	Cancellable  bool
	Editable     bool
	EditLocation string
	EditNote     string
}

type FeedBox struct {
	Active bool
	Since  string
	NewURL string
	// WriteBack names the calendar Bookings are written to, if any.
	WriteBack string
}

type BookingsPage struct {
	AdminFrame
	Alert    string
	Upcoming []BookingRow
	Past     []BookingRow
	Feed     FeedBox
	Error    string
}

templ Bookings(p BookingsPage) {
	@adminLayout("Bookings", p.AdminFrame) {
		if p.Alert != "" {
			<div class="alert" role="alert">
				@iconWarning(20)
				<span style="flex: 1 1 320px">{ p.Alert }</span>
				<a href="/admin/sources">Check sources</a>
			</div>
		}
		<h1 class="a-title">Bookings</h1>
		if p.Error != "" {
			<p class="error" role="alert">{ p.Error }</p>
		}
		<div class="cols">
			<div class="col-3">
				@bookingGroup("Upcoming", p.Upcoming, "Nothing booked yet.")
				@bookingGroup("Past & cancelled", p.Past, "Nothing in the last 30 days.")
			</div>
			<aside aria-labelledby="feed" class="col-1 card" style="gap: 12px">
				<div class="row gap-8">
					@iconCalendar(18)
					<h2 id="feed" style="font-size: 17px">Owner feed</h2>
				</div>
				<p class="ink-2" style="font-size: 14px; line-height: 1.55">Subscribe in your own calendar app to see every Booking, from 30 days ago onward.</p>
				if p.Feed.WriteBack != "" {
					<p class="small notice">Bookings are already written to { p.Feed.WriteBack }, so you probably don't need this feed; with both, each Booking shows twice.</p>
				}
				if p.Feed.NewURL != "" {
					@copyRow("feedurl", "Owner feed URL", p.Feed.NewURL, "btn-outline")
					<span class="small" style="font-weight: 700">Shown only once. Subscribe now.</span>
				} else if p.Feed.Active {
					<span class="small muted">Active since { p.Feed.Since }.</span>
				}
				if p.Feed.Active || p.Feed.NewURL != "" {
					<form method="post" action="/admin/feed" onsubmit="return confirm('Make a new URL? The old one stops working, so you will need to subscribe again.')">
						<button type="submit" class="btn btn-outline">New secret URL</button>
					</form>
				} else {
					<form method="post" action="/admin/feed">
						<button type="submit" class="btn btn-outline">Create secret URL</button>
					</form>
				}
				<span class="small muted">Anyone with this URL sees your Bookings. hima keeps only a hash, so a lost URL can't be shown again.</span>
			</aside>
		</div>
	}
}

templ bookingGroup(title string, rows []BookingRow, empty string) {
	<section class="stack gap-10">
		<h2 class="group-title">{ title }</h2>
		<div class="list">
			if len(rows) == 0 {
				<p class="empty">{ empty }</p>
			}
			for _, b := range rows {
				<article>
					<div class={ "when", templ.KV("past", b.Past) }>
						<span class="small muted">{ b.Day }</span>
						<span class="mono" style="font-size: 16px; font-weight: 500">{ b.Time }</span>
					</div>
					<div class={ "what", templ.KV("past", b.Past) }>
						<div class="row gap-8">
							<span style="font-size: 16px; font-weight: 700">{ b.Name }</span>
							if b.Tag != "" {
								<span class={ "pill", "pill-sm", b.TagClass }>{ b.Tag }</span>
							}
						</div>
						<span class="small muted">{ b.Invite } · { b.Location }</span>
						if b.Note != "" {
							<span class="ink-2" style="font-size: 14px">“{ b.Note }”</span>
						}
					</div>
					if b.Editable {
						<details class="inline-edit">
							<summary class="link-btn" aria-label={ "Edit " + b.Name + "'s Booking" }>Edit</summary>
							<form method="post" action={ templ.SafeURL("/admin/bookings/" + itoa64(b.ID)) } class="stack gap-12">
								<div class="field">
									<label for={ "loc-" + itoa64(b.ID) }>Location</label>
									<input id={ "loc-" + itoa64(b.ID) } class="input" type="text" name="location" value={ b.EditLocation }/>
								</div>
								<div class="field">
									<label for={ "note-" + itoa64(b.ID) }>Note</label>
									<textarea id={ "note-" + itoa64(b.ID) } class="input" name="note" maxlength="1000">{ b.EditNote }</textarea>
								</div>
								<p class="hint">Let the Guest know yourself. A calendar file they already saved won't update.</p>
								<div><button type="submit" class="btn">Save</button></div>
							</form>
						</details>
					}
					if b.Cancellable {
						<form method="post" action={ templ.SafeURL("/admin/bookings/" + itoa64(b.ID) + "/cancel") } onsubmit="return confirm('Cancel this Booking? Let the Guest know yourself.')">
							<button type="submit" class="link-btn danger">Cancel</button>
						</form>
					}
				</article>
			}
		</div>
	</section>
}

// ---------- Availability, sources, activity ----------

type AvailabilityPage struct {
	AdminFrame
	Weekly []KV
	Rules  []KV
}

templ Availability(p AvailabilityPage) {
	@adminLayout("Availability", p.AdminFrame) {
		<h1 class="a-title">Availability</h1>
		<div class="cols">
			<section class="col-2 card" aria-labelledby="wk">
				<h2 id="wk">Weekly hours</h2>
				<dl class="kv">
					for _, d := range p.Weekly {
						<dt>{ d.Key }</dt>
						<dd class="mono">{ d.Value }</dd>
					}
				</dl>
			</section>
			<section class="col-1 card" aria-labelledby="rules">
				<h2 id="rules">Rules</h2>
				<dl class="kv">
					for _, r := range p.Rules {
						<dt>{ r.Key }</dt>
						<dd>{ r.Value }</dd>
					}
				</dl>
			</section>
		</div>
		<p class="small muted">Set in <span class="mono">hima.yaml</span> under <span class="mono">availability</span>. Restart hima after changing it. Invites can narrow these hours but never widen them.</p>
	}
}

type SourceRow struct {
	Name      string
	State     string
	PillClass string
	Checked   string
	AllDay    string
	Error     string
}

type WriteBackRow struct {
	Target    string
	State     string
	PillClass string
	Last      string
	Error     string
}

type SourcesPage struct {
	AdminFrame
	Sources   []SourceRow
	WriteBack *WriteBackRow
}

templ Sources(p SourcesPage) {
	@adminLayout("Calendar sources", p.AdminFrame) {
		<h1 class="a-title">Calendar sources</h1>
		if len(p.Sources) == 0 {
			<div class="card">
				<p class="muted">No calendar sources. Every hour of your Availability is offered as free.</p>
			</div>
		}
		for _, s := range p.Sources {
			<section class="card" style="gap: 12px">
				<div class="row gap-12" style="justify-content: space-between">
					<h2 class="mono" style="font-size: 15px; font-weight: 500; word-break: break-all">{ s.Name }</h2>
					<span class={ "pill", s.PillClass }>{ s.State }</span>
				</div>
				<dl class="kv">
					<dt>Last read</dt>
					<dd>{ s.Checked }</dd>
					<dt>All-day events</dt>
					<dd>{ s.AllDay }</dd>
				</dl>
				if s.Error != "" {
					<p class="alert alert-danger mono" style="font-size: 13px">{ s.Error }</p>
				}
			</section>
		}
		<p class="small muted">Calendar sources are set in <span class="mono">hima.yaml</span> under <span class="mono">calendars</span> (ICS links) and <span class="mono">caldav</span>. hima reads them every 5 minutes. If one can't be read for an hour, Guests see no free times until it can.</p>
		if p.WriteBack != nil {
			<h2 class="group-title">Write-back</h2>
			<section class="card" style="gap: 12px">
				<div class="row gap-12" style="justify-content: space-between">
					<h2 style="font-size: 15px">Bookings are written to { p.WriteBack.Target }</h2>
					<span class={ "pill", p.WriteBack.PillClass }>{ p.WriteBack.State }</span>
				</div>
				<dl class="kv">
					<dt>Last written</dt>
					<dd>{ p.WriteBack.Last }</dd>
				</dl>
				if p.WriteBack.Error != "" {
					<p class="alert alert-danger mono" style="font-size: 13px">{ p.WriteBack.Error }</p>
				}
				<p class="small muted">New, moved and edited Bookings are added or updated there; cancelled ones are removed. hima leaves your other events alone.</p>
			</section>
		}
	}
}

type ActivityItem struct {
	When    string
	Title   string
	Message string
}

type ActivityPage struct {
	AdminFrame
	Items []ActivityItem
}

templ Activity(p ActivityPage) {
	@adminLayout("Activity", p.AdminFrame) {
		<h1 class="a-title">Activity</h1>
		<div class="list">
			if len(p.Items) == 0 {
				<p class="empty">Nothing yet.</p>
			}
			for _, a := range p.Items {
				<article>
					<div class="when">
						<span class="small muted mono">{ a.When }</span>
					</div>
					<div class="what">
						<span style="font-weight: 700">{ a.Title }</span>
						if a.Message != "" {
							<span class="small muted">{ a.Message }</span>
						}
					</div>
				</article>
			}
		</div>
	}
}

// ---------- Settings ----------

type Swatch struct {
	Name    string
	Hex     string
	Checked bool
}

type SettingsPage struct {
	AdminFrame
	Swatches []Swatch
	Custom   string
	Error    string
	Saved    bool
}

templ Settings(p SettingsPage) {
	@adminLayout("Settings", p.AdminFrame) {
		<h1 class="a-title">Settings</h1>
		if p.Saved {
			<p class="notice" role="status">Saved.</p>
		}
		<div class="cols">
			<form method="post" action="/admin/settings" class="col-3 card" aria-labelledby="apph" style="gap: 20px">
				<div class="stack gap-4">
					<h2 id="apph">Accent color</h2>
					<p class="muted" style="font-size: 14px">Used for the logo, buttons and links, here and on every Guest page.</p>
				</div>
				<div role="radiogroup" aria-labelledby="apph" class="swatches">
					for _, s := range p.Swatches {
						<label class="swatch">
							<input type="radio" name="accent" value={ s.Hex } checked?={ s.Checked } data-accent={ s.Hex }/>
							<span class="sw" style={ swatchStyle(s.Hex) }>
								@iconCheck(20)
							</span>
							<span>{ s.Name }</span>
						</label>
					}
				</div>
				<div class="field">
					<label for="hex">Custom</label>
					<input id="hex" class="input mono" style="width: 160px" type="text" name="custom" value={ p.Custom } placeholder="#2D3E8F" spellcheck="false" autocomplete="off"/>
					<span class="hint">Must be dark enough for white text on buttons (contrast 4.5:1 or more).</span>
					if p.Error != "" {
						<span class="error">{ p.Error }</span>
					}
				</div>
				<div class="row gap-12">
					<button type="submit" class="btn">Save</button>
					<button type="submit" name="accent" value="#2D3E8F" formnovalidate class="btn btn-plain">Reset to indigo</button>
				</div>
			</form>
			<aside aria-label="Preview" class="col-1 stack gap-10">
				<span class="eyebrow">Guest page preview</span>
				<div class="preview" id="preview">
					<div class="row gap-8">
						@logoMark(22, false)
						<span class="wordmark" style="font-size: 12px">hima</span>
					</div>
					<div class="inner">
						<span style="font-size: 18px; font-weight: 700">Book time with { p.OwnerName }</span>
						<div class="row gap-6">
							<span class="dur" aria-current="true" style="height: 34px; padding: 0 12px; font-size: 13px">30 min</span>
							<span class="dur" style="height: 34px; padding: 0 12px; font-size: 13px">60 min</span>
						</div>
						<div class="slots" style="grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px">
							<span class="slot" style="height: 34px; font-size: 13px; background: var(--accent); color: #FFFFFF; border: none">14:00</span>
							<span class="slot" style="height: 34px; font-size: 13px">14:30</span>
							<span class="slot" style="height: 34px; font-size: 13px">16:00</span>
						</div>
						<span class="btn btn-block" style="height: 40px; font-size: 14px">Book 14:00 – 14:30</span>
					</div>
				</div>
			</aside>
		</div>
		<script>
			(function () {
				var preview = document.getElementById("preview");
				var hex = document.getElementById("hex");
				function apply(v) { if (/^#[0-9a-f]{6}$/i.test(v)) preview.style.setProperty("--accent", v); }
				document.querySelectorAll("[data-accent]").forEach(function (r) {
					r.addEventListener("change", function () { hex.value = ""; apply(r.value); });
				});
				hex.addEventListener("input", function () { apply(hex.value.trim()); });
			})();
		</script>
	}
}

func swatchStyle(hex string) templ.SafeCSS {
	if !isHexColor(hex) {
		return ""
	}
	return templ.SafeCSS("--sw: " + hex)
}

// ---------- Login ----------

templ Login(failed bool, accent string) {
	@guestLayout("Log in", accent) {
		<div class="centered">
			<main>
				@logoMark(56, false)
				<h1>Log in to hima</h1>
				if failed {
					<p class="error" role="alert">Wrong password.</p>
				}
				<form method="post" action="/admin/login" class="stack gap-12">
					<div class="field">
						<label for="password">Password</label>
						<input id="password" class="input input-lg" type="password" name="password" autocomplete="current-password" autofocus required/>
					</div>
					<button type="submit" class="btn btn-lg btn-block">Log in</button>
				</form>
			</main>
		</div>
	}
}
