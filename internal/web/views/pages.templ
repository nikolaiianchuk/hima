package views

// DeadInvite is shown for Used up, Expired, Revoked and unknown Invites alike,
// so Guests cannot tell them apart.
templ DeadInvite(ownerName string) {
	@layout("Invite unavailable") {
		<h1>This invite is no longer valid</h1>
		<p class="muted">Ask { ownerName } to send you a new one.</p>
	}
}

templ NotFound() {
	@layout("Not found") {
		<h1>Not found</h1>
		<p class="muted">This link doesn't lead anywhere.</p>
	}
}

templ Unavailable() {
	@layout("Temporarily unavailable") {
		<h1>Booking is temporarily unavailable</h1>
		<p class="muted">The calendar couldn't be checked just now. Please try again in a little while.</p>
	}
}

templ Login(failed bool) {
	@layout("Log in") {
		<h1>Log in</h1>
		if failed {
			<p class="error">Wrong password.</p>
		}
		<form method="post" action="/admin/login">
			<label for="password">Password</label>
			<input id="password" type="password" name="password" autocomplete="current-password" autofocus required/>
			<p><button type="submit">Log in</button></p>
		</form>
	}
}
