package views

import "strconv"

templ svgIcon(size int) {
	<svg class="icon" width={ strconv.Itoa(size) } height={ strconv.Itoa(size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		{ children... }
	</svg>
}

templ iconVideo(size int) {
	@svgIcon(size) {
		<rect x="3" y="6" width="13" height="12" rx="2"></rect>
		<path d="M16 10l5-3v10l-5-3z"></path>
	}
}

templ iconPhone(size int) {
	@svgIcon(size) {
		<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"></path>
	}
}

templ iconPin(size int) {
	@svgIcon(size) {
		<path d="M12 21s-6-5.5-6-11a6 6 0 0 1 12 0c0 5.5-6 11-6 11z"></path>
		<circle cx="12" cy="10" r="2.2"></circle>
	}
}

templ iconCalendar(size int) {
	@svgIcon(size) {
		<rect x="3.5" y="5" width="17" height="15" rx="2"></rect>
		<path d="M3.5 10h17M8 3v4M16 3v4"></path>
	}
}

templ iconGlobe(size int) {
	@svgIcon(size) {
		<circle cx="12" cy="12" r="9"></circle>
		<path d="M3 12h18M12 3c3 3.5 3 14.5 0 18M12 3c-3 3.5-3 14.5 0 18"></path>
	}
}

templ iconPerson(size int) {
	@svgIcon(size) {
		<circle cx="12" cy="8" r="3.5"></circle>
		<path d="M5 20c1.2-3.5 4-5 7-5s5.8 1.5 7 5"></path>
	}
}

templ iconChevronLeft(size int) {
	@svgIcon(size) {
		<path d="M15 6l-6 6 6 6"></path>
	}
}

templ iconChevronRight(size int) {
	@svgIcon(size) {
		<path d="M9 6l6 6-6 6"></path>
	}
}

templ iconDownload(size int) {
	@svgIcon(size) {
		<path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path>
	}
}

templ iconCopy(size int) {
	@svgIcon(size) {
		<rect x="9" y="9" width="11" height="11" rx="2"></rect>
		<path d="M5 15V5a2 2 0 0 1 2-2h8"></path>
	}
}

templ iconCheck(size int) {
	<svg class="icon" width={ strconv.Itoa(size) } height={ strconv.Itoa(size) } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M5 12.5l4.5 4.5L19 7.5"></path>
	</svg>
}

templ iconPlus(size int) {
	@svgIcon(size) {
		<path d="M12 5v14M5 12h14"></path>
	}
}

templ iconWarning(size int) {
	@svgIcon(size) {
		<path d="M12 4l9 16H3z"></path>
		<path d="M12 10v4M12 17v.5"></path>
	}
}

templ iconLock(size int) {
	@svgIcon(size) {
		<rect x="5" y="11" width="14" height="9" rx="2"></rect>
		<path d="M8 11V8a4 4 0 0 1 8 0v3"></path>
	}
}

// locationIcon picks the icon for a Location kind.
templ locationIcon(kind string, size int) {
	switch kind {
		case "video":
			@iconVideo(size)
		case "phone":
			@iconPhone(size)
		default:
			@iconPin(size)
	}
}
