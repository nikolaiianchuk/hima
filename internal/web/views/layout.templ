package views

// Assets are the versioned URLs of the stylesheets, set at startup.
type Assets struct {
	CSS   string
	Fonts string
}

// CurrentAssets is set once by the web package at startup.
var CurrentAssets = Assets{CSS: "/static/hima.css", Fonts: "/static/fonts.css"}

templ head(title, accent string) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<meta name="referrer" content="no-referrer"/>
		<meta name="robots" content="noindex"/>
		<title>{ title } · hima</title>
		<link rel="stylesheet" href={ CurrentAssets.Fonts }/>
		<link rel="stylesheet" href={ CurrentAssets.CSS }/>
		<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
		@accentStyle(accent)
	</head>
}

// accentStyle sets the Owner's accent colour. accent is validated as #RRGGBB
// before it gets here, so it is safe to inline.
templ accentStyle(accent string) {
	if isHexColor(accent) {
		@templ.Raw("<style>:root{--accent:" + accent + "}</style>")
	}
}

templ guestLayout(title, accent string) {
	<!DOCTYPE html>
	<html lang="en">
		@head(title, accent)
		<body>
			{ children... }
		</body>
	</html>
}

templ guestHeader(width string) {
	<header class={ "g-head", width }>
		@logoMark(26, false)
		<span class="wordmark">hima</span>
	</header>
}

// detectTimezone reloads the page with the browser's time zone as ?tz= when
// none is set, so Guests see times in their own zone.
templ detectTimezone() {
	<script>
		(function () {
			var u = new URL(location.href);
			if (u.searchParams.has("tz")) return;
			var z = Intl.DateTimeFormat().resolvedOptions().timeZone;
			if (!z) return;
			u.searchParams.set("tz", z);
			location.replace(u);
		})();
	</script>
}

templ copyScript() {
	<script>
		document.addEventListener("click", function (e) {
			var b = e.target.closest("[data-copy]");
			if (!b) return;
			var input = document.getElementById(b.getAttribute("data-copy"));
			navigator.clipboard.writeText(input.value).then(function () {
				var label = b.querySelector("[data-label]");
				if (label) label.textContent = "Copied";
			});
		});
	</script>
}

// copyRow is a read-only field with a Copy button.
templ copyRow(id, label, value, buttonClass string) {
	<div class="copy-row">
		<label for={ id } class="sr-only">{ label }</label>
		<input id={ id } class="input" readonly value={ value } onclick="this.select()"/>
		<button type="button" class={ "btn", buttonClass } data-copy={ id }>
			@iconCopy(16)
			<span data-label>Copy</span>
		</button>
	</div>
}
