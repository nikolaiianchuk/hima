package views

templ layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="referrer" content="no-referrer"/>
			<title>{ title } · hima</title>
			<style>
				:root { color-scheme: light dark; --fg: #1d1d1f; --bg: #fafaf7; --card: #fff; --line: #e4e2dc; --muted: #6e6e73; --accent: #b4553a; --accent-fg: #fff; --ok: #2f7d4f; --warn: #a33; }
				@media (prefers-color-scheme: dark) { :root { --fg: #f2f2ee; --bg: #161615; --card: #1f1f1d; --line: #34332f; --muted: #9a9a95; --accent: #e08a6d; --accent-fg: #1a1a1a; --ok: #6cc08f; --warn: #f08a8a; } }
				* { box-sizing: border-box; }
				body { margin: 0; font: 16px/1.5 system-ui, sans-serif; color: var(--fg); background: var(--bg); }
				main { max-width: 40rem; margin: 0 auto; padding: 2.5rem 1rem 4rem; }
				h1 { font-size: 1.5rem; margin: 0 0 .5rem; }
				h2 { font-size: 1.1rem; margin: 2rem 0 .75rem; }
				a { color: var(--accent); }
				p { margin: .5rem 0; }
				.muted { color: var(--muted); }
				.small { font-size: .875rem; }
				.error { color: var(--warn); }
				.ok { color: var(--ok); }
				.card { background: var(--card); border: 1px solid var(--line); border-radius: .75rem; padding: 1rem 1.25rem; margin: 1rem 0; }
				.row { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; }
				.pill { display: inline-block; padding: .35rem .75rem; border: 1px solid var(--line); border-radius: 999px; text-decoration: none; color: var(--fg); }
				.pill.active { background: var(--accent); border-color: var(--accent); color: var(--accent-fg); }
				.day { margin: 1.25rem 0 .5rem; font-weight: 600; }
				.slots { display: grid; grid-template-columns: repeat(auto-fill, minmax(5.5rem, 1fr)); gap: .5rem; }
				.slots a { text-align: center; padding: .5rem; border: 1px solid var(--line); border-radius: .5rem; background: var(--card); text-decoration: none; color: var(--fg); font-variant-numeric: tabular-nums; }
				.slots a:hover { border-color: var(--accent); }
				.busy { color: var(--muted); font-size: .875rem; font-variant-numeric: tabular-nums; }
				label { display: block; margin: .75rem 0 .25rem; font-weight: 500; }
				label.inline { display: inline-flex; gap: .35rem; align-items: center; font-weight: 400; margin: .25rem .75rem .25rem 0; }
				input[type=text], input[type=number], input[type=date], input[type=password], textarea, select { font: inherit; width: 100%; padding: .5rem .65rem; border: 1px solid var(--line); border-radius: .5rem; background: var(--card); color: var(--fg); }
				textarea { min-height: 5rem; }
				button, .button { font: inherit; display: inline-block; padding: .55rem 1rem; background: var(--accent); color: var(--accent-fg); border: 0; border-radius: .5rem; cursor: pointer; text-decoration: none; }
				button.secondary, .button.secondary { background: transparent; color: var(--fg); border: 1px solid var(--line); }
				button.danger { background: transparent; color: var(--warn); border: 1px solid var(--line); }
				form.inline { display: inline; }
				table { width: 100%; border-collapse: collapse; font-size: .9rem; }
				td, th { text-align: left; padding: .5rem .4rem; border-bottom: 1px solid var(--line); vertical-align: top; }
				.link-box { display: flex; gap: .5rem; } .link-box input { flex: 1; font-family: ui-monospace, monospace; font-size: .85rem; }
				.table-wrap { overflow-x: auto; }
			</style>
		</head>
		<body>
			<main>
				{ children... }
			</main>
		</body>
	</html>
}

// detectTimezone reloads the page with the browser's time zone as ?tz= when
// none is set, so Guests see times in their own zone.
templ detectTimezone() {
	<script>
		(function () {
			var u = new URL(location.href);
			if (u.searchParams.has("tz")) return;
			var z = Intl.DateTimeFormat().resolvedOptions().timeZone;
			if (!z) return;
			u.searchParams.set("tz", z);
			location.replace(u);
		})();
	</script>
}
